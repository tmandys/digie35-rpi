#!/bin/sh
set -eu

# dpkg also invokes postinst for recovery actions.
case "${1:-configure}" in configure) ;; *) exit 0 ;; esac

CONFIG=/boot/firmware/config.txt

if [ ! -f "$CONFIG" ]; then
    CONFIG=/boot/config.txt
    if [ ! -f "$CONFIG" ]; then
      echo "/boot/*/config.txt" file not found
      exit 1
    fi
fi
echo "Patching $CONFIG"

raspi-config nonint do_i2c 0
CMDLINE="$(dirname "$CONFIG")/cmdline.txt"
python3 /usr/lib/rpi-digie35/patch-boot-config.py "$CONFIG" "$CMDLINE"

model=$(tr -d '\000' < /sys/firmware/devicetree/base/model)
case "$model" in
    "Raspberry Pi 3"*|"Raspberry Pi 4"*)
        # PL011 moves from onboard Bluetooth to GPIO14/15 after reboot.
        if systemctl cat hciuart.service >/dev/null 2>&1; then
            systemctl disable --now hciuart.service
        fi
        ;;
esac
# Prevent explicit and generated login services from claiming the serial link.
systemctl mask --now serial-getty@ttyAMA0.service serial-getty@serial0.service serial-getty@ttyS0.service
usermod -a -G dialout pi
echo "UART0 configured for GPIO14/15; reboot before using Digie35 UART."

echo "Patching EEPROM"
# Pi 3 has no updatable bootloader EEPROM.
case "$model" in
    "Raspberry Pi 3"*) echo "Skipping bootloader EEPROM on $model" ;;
    *) EDITOR=/usr/lib/rpi-digie35/patch-eeprom-config.sh rpi-eeprom-config -e ;;
esac

FILE=/etc/log2ram.conf
echo "Patching $FILE"
sed "$FILE" -i -e "s/^SIZE=.*/SIZE=100M/"
sed "$FILE" -i -e "s/^MAIL=true/MAIL=false/"

FILE=/etc/samba/smb.conf
if ! grep -q "^\[media\]" "$FILE" ; then
  echo "Patching $FILE"
  sed "$FILE" -i -e "\$a[media]"
  sed "$FILE" -i -e "\$a\   comment = Mounted removable disks"
  sed "$FILE" -i -e "\$a\   path = /media/pi"
  sed "$FILE" -i -e "\$a\   read only = no"
  smbcontrol smbd reload-config
else
  echo "Patching $FILE skipped"
fi

# setting numlock
# numlockx does not work on wayland
#FILE=/usr/share/lightdm/lightdm.conf.d/01_debian.conf
#if ! grep -q "^greeter-setup-script=" "$FILE" ; then
#  echo "Patching $FILE"
#  sed "$FILE" -i -e "\$agreeter-setup-script=/usr/bin/numlockx on"
#else
#  echo "Patching $FILE skipped"
#fi

FILE=/home/pi/.config/wayfire.ini
crudini --set "$FILE" input kb_numlock_default_state true

# setting onscreen keyboard toggle
FILE=/home/pi/.config/wf-panel-pi.ini
if ! grep -q "^launcher_900004=" "$FILE" ; then
  echo "Patching $FILE"
  sed "$FILE" -i -e "\$alauncher_900004=wvkbd.desktop"
else
  echo "Patching $FILE skipped"
fi

# wireshark stuff
echo "May require 'sudo dpkg-reconfigure wireshark-common' to allow non-superuser to capture traffic"
usermod -a -G wireshark pi
modprobe usbmon
setfacl -m u:pi:r /dev/usbmon*

rm -f /usr/lib/python3.11/EXTERNALLY-MANAGED

FILE=/etc/hostname
sed "$FILE" -i -e "s/^raspberrypi/digie35/"
